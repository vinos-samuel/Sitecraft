datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Lead {
  id                  String    @id @default(cuid())
  name                String
  rating              String
  reviewsCount        String
  phone               String
  website             String
  address             String
  painPoints          String    // JSON string
  websiteQualityScore Int
  lat                 Float
  lng                 Float
  offer               String?   // the offer used when this lead was scanned
  outreachEmail       String?
  landingPageHtml     String?
  liveWebsiteUrl      String?

  // CRM fields
  contactEmail        String?   // prospect's actual email address
  notes               String?   // free-text notes per lead
  lastContactedAt     DateTime?
  followUpAt          DateTime? // snooze / scheduled next action

  // Status: NEW | CONTACTED | FOLLOW_UP | REPLIED | CLOSED | LOST
  status              String    @default("NEW")
  createdAt           DateTime  @default(now())
}

model Territory {
  id        String   @id @default(cuid())
  name      String
  geoJson   String   // JSON string representing polygon boundaries
  createdAt DateTime @default(now())
}
